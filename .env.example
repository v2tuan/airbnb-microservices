# Application ports exposed to host
AIRBNB_CLIENT_PORT=3000
API_GATEWAY_PORT=8888
GATEWAY_DOWNSTREAM_CONNECT_TIMEOUT_MS=3000
GATEWAY_DOWNSTREAM_RESPONSE_TIMEOUT_SECONDS=15
GATEWAY_DOWNSTREAM_PENDING_ACQUIRE_TIMEOUT_SECONDS=5

# JVM runtime options shared by Spring Boot containers
JAVA_OPTS=

# Cloud PostgreSQL URLs and credentials.
# No PostgreSQL container is defined in docker-compose.yml.
ACTIVITY_DB_URL=jdbc:postgresql://<cloud-host>/<activity-db>?sslmode=require
ACTIVITY_DB_USERNAME=<activity-db-user>
ACTIVITY_DB_PASSWORD=<activity-db-password>

BOOKING_DB_URL=jdbc:postgresql://<cloud-host>/<booking-db>?sslmode=require
BOOKING_DB_USERNAME=<booking-db-user>
BOOKING_DB_PASSWORD=<booking-db-password>

LISTING_DB_URL=jdbc:postgresql://<cloud-host>/<listing-db>?sslmode=require
LISTING_DB_USERNAME=<listing-db-user>
LISTING_DB_PASSWORD=<listing-db-password>

PAYMENT_DB_URL=jdbc:postgresql://<cloud-host>/<payment-db>?sslmode=require
PAYMENT_DB_USERNAME=<payment-db-user>
PAYMENT_DB_PASSWORD=<payment-db-password>

RATING_DB_URL=jdbc:postgresql://<cloud-host>/<rating-db>?sslmode=require
RATING_DB_USERNAME=<rating-db-user>
RATING_DB_PASSWORD=<rating-db-password>

USER_DB_URL=jdbc:postgresql://<cloud-host>/<user-db>?sslmode=require
USER_DB_USERNAME=<user-db-user>
USER_DB_PASSWORD=<user-db-password>

WISHLIST_DB_URL=jdbc:postgresql://<cloud-host>/<wishlist-db>?sslmode=require
WISHLIST_DB_USERNAME=<wishlist-db-user>
WISHLIST_DB_PASSWORD=<wishlist-db-password>

# MongoDB is external/cloud unless you explicitly run it yourself.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
DATABASE_NAME=airbnb_message
NOTIFICATION_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Kafka is not defined in the app compose file.
# If you use the existing local Kafka compose, make sure its advertised listener is reachable from app containers.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Keycloak runs in docker-compose.yml.
# Browser login is handled through user-service; containers validate tokens against the internal Keycloak URL.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/airbnb
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/airbnb/protocol/openid-connect/certs
IDP_URL=http://keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<keycloak-admin-password>
KC_DB_URL=jdbc:postgresql://<cloud-host>/<keycloak-db>?sslmode=require
KC_DB_USERNAME=<keycloak-db-user>
KC_DB_PASSWORD=<keycloak-db-password>
KC_DB_SCHEMA=public
USER_SERVICE_IDP_CLIENT_ID=user_service
USER_SERVICE_IDP_CLIENT_SECRET=<user-service-client-secret>
PAYMENT_SERVICE_IDP_CLIENT_ID=payment_service
PAYMENT_SERVICE_IDP_CLIENT_SECRET=<payment-service-client-secret>
JWT_SIGNER_KEY=<legacy-jwt-signer-key-if-needed>

# Redis is optional. Keep CACHE_TYPE=simple unless you explicitly enable Redis.
CACHE_TYPE=simple
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# Public app URLs.
# For Cloudflare Tunnel, replace the localhost values with your tunnel URL,
# for example: https://your-tunnel.trycloudflare.com
APP_FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:3000,http://localhost:3001
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<mail-username>
MAIL_PASSWORD=<mail-password>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>

# Chatbot / Spring AI
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048
CHATBOT_RESPONSE_TIMEOUT=60s
CHATBOT_LISTING_MAX_RESULTS=6
LISTING_SERVICE_TIMEOUT=3s

# Frontend build-time public variables
NEXT_INTERNAL_API_BASE_URL=http://api-gateway:8888
NEXT_PUBLIC_API_BASE_URL=http://localhost:8888
NEXT_PUBLIC_PREFIX=/api/v1
NEXT_PUBLIC_MESSAGE_SERVICE_URL=http://localhost:8888
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:8888/api/v1/notification
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# message-service legacy JWT fallback; disabled by default
ALLOW_LEGACY_JWT=false
ACCESS_TOKEN_SECRET_SIGNATURE=

# Payment schedulers
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_DELAY_MS=3600000
PAYOUT_SCHEDULER_DELAY_MS=60000
